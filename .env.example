TMDB_API_KEY=your_tmdb_api_key_here

# SQLite (default) or PostgreSQL
# DATABASE_URL=sqlite:///./data/indie_recs.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/indie_recs

DATABASE_URL=sqlite:///./data/indie_recs.db
